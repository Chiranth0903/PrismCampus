# Copy to .env.local. Never commit .env.local or paste keys in chat.
PRISM_ADMIN_PASSWORD=
# Public HTTPS address of your hosted PrismCampus registry (not Agent37's control API).
PUBLIC_CAMPUS_REGISTRY_URL=
AGENT37_API_KEY=
AGENT37_INSTANCE_ID=
NODUS_API_KEY=
NODUS_MODEL=nodus/gpt-oss-20b
# Use a persistent volume when hosting on Agent37.
# PRISM_DB_PATH=/home/node/prism/prism_campus.db
